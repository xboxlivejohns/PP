---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import CTA from '../components/CTA.astro';
import DetailStory from '../components/DetailStory.astro';
import '../styles/gallery.css';

const works = [
  {
    image: 'vauxhall-finish',
    title: 'Finished exterior.',
    car: 'Vauxhall Insignia',
    category: 'exteriors',
    composition: 'wide',
    alt: 'White Vauxhall Insignia with clean wheels and finished paintwork',
  },
  {
    image: 'blue-bmw-finish',
    title: 'Finished blue paintwork.',
    car: 'BMW X5',
    category: 'exteriors',
    composition: 'narrow',
    alt: 'Blue BMW X5 bonnet and front end with clear reflections, from the later job footage',
  },
  {
    image: 'light-leather-interior',
    title: 'Clean leather and door trim.',
    car: 'Light-leather interior',
    category: 'interiors',
    composition: 'half',
    alt: 'Clean light leather passenger seat and detailed door trim',
  },
  {
    image: 'audi-wheel-finish',
    title: 'Down to the wheels.',
    car: 'Audi',
    category: 'exteriors',
    composition: 'half',
    alt: 'White Audi rear quarter with clean dark alloy wheel',
  },
  {
    image: 'art-porsche-front',
    title: 'Finished blue bodywork.',
    car: 'Porsche 911',
    category: 'exteriors',
    composition: 'wide',
    alt: 'Sky reflected across the blue bonnet and rounded headlights of a freshly detailed Porsche 911',
  },
  {
    image: 'bmw',
    title: 'Gloss after ceramic coating.',
    car: 'BMW · Ceramic coating detail',
    category: 'exteriors',
    composition: 'narrow',
    alt: 'Green BMW bonnet and headlight reflecting the sky',
  },
  {
    image: 'taycan-interior',
    title: 'Clean seats and dashboard.',
    car: 'Porsche Taycan',
    category: 'interiors',
    composition: 'third',
    alt: 'Clean black leather seats and dashboard in a Porsche Taycan',
  },
  {
    image: 'art-bmw-rear',
    title: 'Finished green paintwork.',
    car: 'BMW · Finished exterior',
    category: 'exteriors',
    composition: 'third',
    alt: 'Glossy emerald green BMW rear quarter, red rear lamp and black alloy wheel after detailing',
  },
  {
    image: 'art-porsche-console',
    title: 'The details inside.',
    car: 'Porsche 911',
    category: 'interiors',
    composition: 'third',
    alt: 'Detailed Porsche interior showing the centre console, carbon trim and yellow rev counter',
  },
  {
    image: 'art-mercedes-exterior',
    title: 'A deeper gloss.',
    car: 'Mercedes-Benz',
    category: 'exteriors',
    composition: 'wide',
    alt: 'Finished black Mercedes SUV with clear reflections across its side panels and bonnet',
  },
  {
    image: 'range-rover',
    title: 'Finished coating detail.',
    car: 'Range Rover Sport · Ceramic coating detail',
    category: 'exteriors',
    composition: 'narrow',
    alt: 'Grey Range Rover Sport parked on a driveway after detailing',
  },
  {
    image: 'porsche-interior',
    title: 'Clean seats and console.',
    car: 'Porsche 911',
    category: 'interiors',
    composition: 'third',
    alt: 'Clean Porsche 911 front seats and console',
  },
  {
    image: 'range-detail',
    title: 'Finished bonnet.',
    car: 'Range Rover Sport',
    category: 'exteriors',
    composition: 'third',
    alt: 'Detailed Range Rover bonnet with clear sky reflections',
  },
  {
    image: 'mercedes-interior',
    title: 'Clean cabin and dashboard.',
    car: 'Mercedes-Benz',
    category: 'interiors',
    composition: 'third',
    alt: 'Finished black Mercedes-Benz cabin with clean seats and dashboard',
  },
  {
    image: 'polishing',
    title: 'The work behind the gloss.',
    car: 'Machine polishing',
    category: 'process',
    composition: 'half',
    alt: 'Machine polisher working on a grey Range Rover door',
  },
  {
    image: 'coating-product',
    title: 'The coating we use.',
    car: 'Matrix Blue · Ceramic coating product',
    category: 'process',
    composition: 'half',
    alt: 'Autosmart Matrix Blue coating bottle held beside a Range Rover',
  },
];
const fullWidth = (name: string) =>
  name === 'bmw'
    ? 800
    : ['art-bmw-rear', 'vauxhall-finish', 'blue-bmw-finish', 'audi-wheel-finish'].includes(name)
      ? 1080
      : 1600;
---

<Layout
  title="Our Work — Real Car Detailing Results"
  description="Explore genuine Polished & Pristine detailing work: finished exteriors, refreshed interiors, ceramic coating details and the process behind them."
>
  <section class="gallery-hero" aria-labelledby="gallery-heading">
    <div class="container gallery-hero-inner">
      <div class="gallery-hero-copy">
        <p class="gallery-kicker">The Polished & Pristine portfolio</p>
        <h1 id="gallery-heading">
          <span>Our detailing</span>
          <span>work.</span>
        </h1>
        <p class="gallery-hero-description">
          See finished paintwork, clean interiors and the work involved.
          These are customer cars detailed by Polished & Pristine.
        </p>
        <a class="gallery-browse" href="#finished-work">
          <span>Explore the work</span>
          <span class="gallery-browse-icon">
            <Icon />
          </span>
        </a>
      </div>
      <div class="gallery-hero-art">
        <figure class="gallery-hero-main">
          <Photo
            name="range-detail"
            alt="The sky reflected in the finished bonnet of a Range Rover Sport"
            eager
            sizes="(max-width: 760px) 90vw, 48vw"
          />
          <figcaption>
            <span>Range Rover Sport</span>
            <span>Finished detail</span>
          </figcaption>
        </figure>
        <figure class="gallery-hero-inset">
          <Photo
            name="porsche-detail"
            alt="Deep blue Porsche paintwork and a glossy black door mirror after detailing"
            eager
            sizes="(max-width: 760px) 36vw, 18vw"
          />
          <figcaption>Paintwork and mirror detail.</figcaption>
        </figure>
        <span class="gallery-art-word" aria-hidden="true">
          Pristine.
        </span>
      </div>
    </div>
    <div class="container gallery-hero-foot">
      <span>Real cars. Personal attention.</span>
      <a href="#transformation">
        See an interior transformation <Icon name="diagonal" size={16} />
      </a>
    </div>
  </section>

  <section
    class="gallery-collection"
    id="finished-work"
    aria-labelledby="gallery-selection-heading"
  >
    <div class="container">
      <div class="gallery-selection-intro">
        <h2 id="gallery-selection-heading">
          Browse our
          <br />recent work.
        </h2>
        <p>
          Finished bodywork, refreshed interiors and some of the work behind them. Select a
          photograph for a closer look.
        </p>
      </div>
      <div class="gallery-toolbar">
        <div class="filter-buttons" role="group" aria-label="Filter work" hidden>
          <button data-filter="all" aria-pressed="true">
            All work
          </button>
          <button data-filter="exteriors" aria-pressed="false">
            Exteriors
          </button>
          <button data-filter="interiors" aria-pressed="false">
            Interiors
          </button>
          <button data-filter="process" aria-pressed="false">
            The process
          </button>
        </div>
        <p id="gallery-count" aria-live="polite" aria-atomic="true">
          {works.length} selected details
        </p>
      </div>
      <div class="gallery-grid gallery-mosaic">
        {works.map((work) => (
          <figure
            class={`gallery-item gallery-piece gallery-piece--${work.composition}`}
            data-category={work.category}
          >
            <a
              href={`/media/${work.image}-${fullWidth(work.image)}.webp`}
              class="gallery-open"
              data-title={`${work.car} — ${work.title}${work.category === 'process' ? ' In progress.' : ''}`}
              aria-label={`Enlarge ${work.car} photo`}
            >
              <Photo
                name={work.image}
                alt={work.alt}
                sizes="(max-width: 600px) 90vw, (max-width: 1000px) 45vw, 60vw"
              />
              <span class="gallery-enlarge" aria-hidden="true">
                <Icon name="plus" />
              </span>
              {work.category === 'process' && <span class="stage-tag">In progress</span>}
            </a>
            <figcaption>
              <div>
                <p>{work.car}</p>
                <h3>{work.title}</h3>
              </div>
              <span aria-hidden="true">
                <Icon name="diagonal" size={18} />
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
      <p class="gallery-authenticity">All photographs show our own detailing work.</p>
    </div>
  </section>

  <section
    class="gallery-transformation"
    id="transformation"
    aria-labelledby="transformation-heading"
  >
    <div class="container gallery-transformation-grid">
      <div class="gallery-transformation-copy">
        <p class="gallery-kicker">Interior deep cleaning</p>
        <h2 id="transformation-heading">
          Interior cleaning.
          <br />
          Before and after.
        </h2>
        <p>
          I gave the seat fabric a thorough clean and worked into the gaps around the rails and
          centre console. Those easily missed areas make a difference to how clean the whole
          interior feels.
        </p>
        <a class="text-link" href="/booking/?service=interior-deep-clean">
          Discuss your interior clean <Icon />
        </a>
      </div>
      <div class="gallery-transformation-proof">
        <div class="gallery-comparison">
          <figure>
            <div class="gallery-comparison-image">
              <Photo
                name="seat-before"
                alt="Before cleaning: marked grey passenger seat, dust around the console and debris along the seat rail"
                sizes="(max-width: 700px) 44vw, 26vw"
              />
            </div>
            <figcaption>
              <span class="gallery-condition-dot" aria-hidden="true"></span>Before cleaning
            </figcaption>
          </figure>
          <figure>
            <div class="gallery-comparison-image">
              <Photo
                name="seat-after"
                alt="After cleaning: the same passenger seat with cleaner fabric, console and rail, photographed in sunlight"
                sizes="(max-width: 700px) 44vw, 26vw"
              />
            </div>
            <figcaption>
              <span
                class="gallery-condition-dot gallery-condition-dot--after"
                aria-hidden="true"
              ></span>
              After cleaning
            </figcaption>
          </figure>
        </div>
        <p class="gallery-comparison-note">
          The same vehicle’s passenger seat, photographed from different angles and in different
          light. No retouching of the fabric or marks.
        </p>
      </div>
    </div>
  </section>

  <DetailStory />
  <section class="gallery-film" aria-labelledby="film-heading">
    <div class="container gallery-film-inner">
      <div class="gallery-film-copy">
        <p class="gallery-kicker">Captured on the job</p>
        <h2 id="film-heading">
          Finished paintwork.
          <br />
          On video.
        </h2>
        <p id="video-description">
          Follow the reflections along this green BMW’s side panel after a ceramic coating detail. A
          short, silent look at the finished paintwork.
        </p>
        <p class="gallery-film-note">Real footage. No colour grading or retouching.</p>
        <a class="text-link" href="/ceramic-coating/">
          Discover the coating package <Icon />
        </a>
      </div>
      <div class="gallery-film-stage">
        <span class="gallery-film-word" aria-hidden="true">
          In motion.
        </span>
        <div class="gallery-film-player" data-video-shell>
          <video
            controls
            playsinline
            preload="none"
            poster="/media/bmw-finish-poster.webp"
            aria-label="Silent video showing reflections along the green BMW’s finished side panel"
            aria-describedby="video-description"
          >
            <source src="/media/bmw-finish.mp4" type="video/mp4" />
            <p>
              Your browser cannot play this video.{' '}
              <a href="/media/bmw-finish.mp4">Download the finish detail clip</a>.
            </p>
          </video>
          <button
            class="media-play-button"
            type="button"
            data-video-play
            aria-label="Play the BMW finish video"
          >
            <span class="media-play-icon" aria-hidden="true">
              ▶
            </span>
            <span>Play video</span>
          </button>
        </div>
        <p class="gallery-film-caption">
          BMW <span>Ceramic coating detail</span>
        </p>
      </div>
    </div>
  </section>

  <dialog id="gallery-dialog" class="gallery-lightbox" aria-labelledby="dialog-caption">
    <button class="dialog-close" aria-label="Close enlarged photo">
      <Icon name="close" size={24} />
    </button>
    <img id="dialog-image" alt="" width="1200" height="1600" />
    <p id="dialog-caption"></p>
  </dialog>
  <CTA />
</Layout>

<script>
  import gsap from 'gsap';
  const galleryMotion = gsap.matchMedia();
  galleryMotion.add('(prefers-reduced-motion: no-preference)', () => {
    gsap
      .timeline({ defaults: { ease: 'power3.out', duration: 1 } })
      .from('.gallery-hero h1 span', { y: 48, autoAlpha: 0, stagger: 0.12, clearProps: 'all' })
      .from('.gallery-hero-main img', { scale: 1.07, duration: 1.4, clearProps: 'transform' }, 0)
      .from('.gallery-hero-inset', { y: 36, rotation: -3, autoAlpha: 0, clearProps: 'all' }, 0.25)
      .from(
        '.gallery-hero-description, .gallery-browse',
        { y: 12, autoAlpha: 0, stagger: 0.08, clearProps: 'all' },
        0.35,
      );
    const filters = document.querySelector('.gallery-collection .filter-buttons');
    const animateSelection = () => {
      requestAnimationFrame(() => {
        gsap.fromTo(
          '.gallery-piece:not([hidden])',
          { y: 18, autoAlpha: 0 },
          {
            y: 0,
            autoAlpha: 1,
            duration: 0.45,
            stagger: 0.035,
            ease: 'power2.out',
            overwrite: true,
            clearProps: 'all',
          },
        );
      });
    };
    filters?.addEventListener('click', animateSelection);
    return () => filters?.removeEventListener('click', animateSelection);
  });
</script>
