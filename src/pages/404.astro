---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found"
  description="Find your way back to Polished & Pristine mobile car detailing."
  noindex
>
  <section class="section container not-found">
    <p class="eyebrow">Page not found</p>
    <h1>
      Let’s get you
      <br />
      back on the road.
    </h1>
    <p>This page may have moved. Explore our services or head back to the homepage.</p>
    <div class="actions">
      <a class="button" href="/">
        Back to home
      </a>
      <a class="text-link" href="/services/">
        Explore services
      </a>
    </div>
  </section>
</Layout>
