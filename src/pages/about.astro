---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import CTA from '../components/CTA.astro';
import WorkPreview from '../components/WorkPreview.astro';
import Icon from '../components/Icon.astro';
import { business } from '../data/business';
---

<Layout
  title="Meet Your Mobile Detailer in Darlington"
  description="Personal car care from Polished & Pristine. Fully insured mobile detailing with our own water and power, based in Darlington and covering nearby areas."
>
  <section class="split-intro container about-intro">
    <div>
      <p class="eyebrow">The person behind the polish</p>
      <h1>
        Meet your
        <br />
        local
        <br />
        detailer.
      </h1>
      <p>
        I’m John, the owner and detailer behind Polished & Pristine. I provide professional mobile
        car care from my base in Darlington, looking after vehicles at customers’ homes and
        workplaces.
      </p>
      <p>
        Whether your car needs a thorough clean, machine polishing or ceramic protection, we start
        by discussing the result you want and what is right for the vehicle.
      </p>
      <a class="button" href="/booking/">
        Get in touch <Icon name="message" />
      </a>
    </div>
    <figure class="split-photo owner-photo">
      <Photo
        name="john-on-the-job"
        alt="John, owner of Polished & Pristine, beside a customer's Range Rover with his polishing equipment"
        eager
        sizes="(max-width: 760px) 200px, 280px"
      />
      <figcaption>John · Owner and detailer, based in Darlington</figcaption>
    </figure>
  </section>
  <section class="pale-section">
    <div class="container benefits">
      <div>
        <Icon name="message" size={30} />
        <h2>A direct conversation</h2>
        <p>
          Speak with the person doing the work. Discuss the condition, the finish you want and the
          service that makes sense.
        </p>
      </div>
      <div>
        <Icon name="pin" size={30} />
        <h2>Care that comes to you</h2>
        <p>
          Professional equipment, our own water and power, and mineral-free water to reduce water
          spots. Everything comes to your agreed location.
        </p>
      </div>
      <div>
        <Icon name="shield" size={30} />
        <h2>Fully insured detailing</h2>
        <p>
          Fully insured detailing, with the service and quote agreed before work begins. Any machine
          polishing is tailored to the condition of your paint.
        </p>
      </div>
    </div>
  </section>
  <section class="section container area-section" id="service-area">
    <div>
      <p class="eyebrow">Based in Darlington</p>
      <h2>
        Areas
        <br />
        we cover
      </h2>
      <p>{business.coverageSummary}</p>
      <p>Send your postcode with your enquiry so we can confirm availability for your address.</p>
      <a class="button" href="/areas-covered/">
        Explore the areas we cover <Icon name="pin" />
      </a>
    </div>
    <div class="area-card">
      <Icon name="pin" size={32} />
      <h3>Based in Darlington</h3>
      <ul>
        {business.areas.map((area) => (
          <li>{area}</li>
        ))}
      </ul>
      <p>Nearby towns are a guide. Coverage is confirmed for your postcode.</p>
    </div>
  </section>
  <WorkPreview />
  <CTA title="Get in touch about your car." />
</Layout>

<style>
  .about-intro {
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.65fr);
    align-items: center;
  }
  .about-intro .owner-photo {
    width: min(100%, 280px);
    margin: 0;
    justify-self: center;
  }
  .about-intro .owner-photo :global(picture) {
    height: auto;
    aspect-ratio: 3 / 4;
    border-radius: 16px;
  }
  .about-intro .owner-photo :global(img) {
    transform: scaleX(-1);
    object-position: center;
  }
  .about-intro .owner-photo figcaption {
    font-size: 13px;
    line-height: 1.6;
    letter-spacing: 0;
  }
  @media (max-width: 760px) {
    .about-intro {
      grid-template-columns: minmax(0, 1fr);
    }
    .about-intro .owner-photo {
      width: min(100%, 200px);
      justify-self: start;
    }
  }
</style>
