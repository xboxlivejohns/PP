---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import CTA from '../components/CTA.astro';
import CustomerReview from '../components/CustomerReview.astro';
import { customerReviews } from '../data/reviews';
import data from '../../content/services.json';
const groups = [
  {
    id: 'valeting',
    legacyId: 'clean-maintain',
    name: 'Valeting & interior care',
    intro:
      'Choose a regular inside-and-out clean or a deeper reset for a car that needs more care.',
    categories: ['Cleaning & valeting'],
    image: 'honda-interior',
    alt: 'Clean Honda front cabin',
    detail: 'taycan-interior',
    detailAlt: 'Detailed black leather seats and centre console in a Porsche Taycan',
  },
  {
    id: 'paintwork',
    legacyId: 'restore-refine',
    name: 'Paint enhancement & correction',
    intro:
      'Machine polishing can reduce marks and restore gloss. The right level depends on your paint’s condition.',
    categories: ['Paintwork'],
    image: 'range-detail',
    alt: 'Smooth reflections on finished grey Range Rover paint',
    detail: 'blue-bmw-finish',
    detailAlt: 'Reflections on finished blue BMW paintwork and front light',
  },
  {
    id: 'protection',
    legacyId: 'protect-preserve',
    name: 'Ceramic protection',
    intro:
      'A liquid protective coating applied after careful cleaning and polishing, designed to last up to three years.',
    categories: ['Ceramic protection'],
    image: 'bmw',
    alt: 'Green BMW finished bonnet from a ceramic coating detail',
    detail: 'art-bmw-rear',
    detailAlt:
      'Glossy green BMW rear quarter and rear lamp from a completed ceramic coating detail',
  },
  {
    id: 'specialist',
    legacyId: 'specialist-care',
    name: 'Specialist care',
    intro:
      'Need something more specific? Tell us about the vehicle and what you would like to improve.',
    categories: ['Specialist services', 'Specialist enquiries'],
    image: null,
  },
];
const serviceRecommendations: Record<string, string> = {
  'full-valet': 'Most popular',
  'paint-enhancement': 'Best for gloss',
  'ceramic-coating': 'Best protection',
};
const categoryLinks: Record<string, { href: string; label: string }> = {
  valeting: { href: '/valeting/', label: 'Explore valeting & interior cleaning' },
  paintwork: { href: '/paint-correction/', label: 'Explore paint enhancement & correction' },
  protection: { href: '/ceramic-coating/', label: 'Explore ceramic coating' },
};
const popularServices = ['full-valet', 'paint-enhancement', 'ceramic-coating'].map((id) =>
  data.services.find((service) => service.id === id)!,
);
---

<Layout
  title="Car Detailing Services & Prices in Darlington"
  description={`Explore Polished & Pristine services and prices: valeting ${data.services.find((s) => s.id === 'essential-clean')!.price.display.toLowerCase()}, interior deep cleaning, paint enhancement, correction and ceramic coating.`}
>
  <section class="page-intro container services-opening">
    <div class="services-opening-copy">
      <p class="eyebrow">Services & prices</p>
      <h1>
        The right care.
        <br />
        For your car.
      </h1>
      <div class="intro-bottom">
        <p>
          Choose anything from a regular clean to paint polishing and long-term protection. We’ll
          confirm the right service and price for your vehicle before you book.
        </p>
        <span class="intro-note">
          Mobile detailing in Darlington
          <br />
          and the surrounding North East
        </span>
      </div>
    </div>
    <div class="services-opening-art">
      <Photo
        name="vauxhall-finish"
        alt="White Vauxhall Insignia with glossy finished paintwork and clean wheels"
        eager
        sizes="(max-width:760px) 90vw, 47vw"
        class="services-opening-main"
      />
      <Photo
        name="art-porsche-console"
        alt="Detailed Porsche 911 centre console with carbon trim and yellow rev counter"
        sizes="(max-width:760px) 40vw, 20vw"
        class="services-opening-inset"
      />
      <a class="services-gallery-link" href="/gallery/">
        Real cars. See the gallery <Icon name="diagonal" size={18} />
      </a>
    </div>
  </section>
  <section class="popular-services" aria-labelledby="popular-services-title">
    <div class="container popular-services-inner">
      <div class="popular-services-heading">
        <p class="eyebrow">Popular starting points</p>
        <h2 id="popular-services-title">Popular services at a glance.</h2>
        <p>
          Starting prices for three of our most requested services. The full menu continues below.
        </p>
      </div>
      <div class="popular-services-list">
        {popularServices.map((service, index) => (
          <a href={`#${service.id}`}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{service.name}</strong>
            <b>{service.price.display}</b>
            <Icon name="diagonal" size={17} />
          </a>
        ))}
      </div>
    </div>
  </section>
  <nav class="service-jump" aria-label="Service categories">
    <div class="container">
      {groups.map((g) => (
        <a href={`#${g.id}`}>{g.name}</a>
      ))}
    </div>
  </nav>
  <div class="container service-menu">
    {groups.map((g) => (
      <section class="service-group" id={g.id}>
        <div class="service-group-intro" id={g.legacyId} style="scroll-margin-top: 120px">
          <h2>{g.name}</h2>
          <p>{g.intro}</p>
          {categoryLinks[g.id] && (
            <a class="text-link service-category-link" href={categoryLinks[g.id].href}>
              {categoryLinks[g.id].label} <Icon name="diagonal" size={17} />
            </a>
          )}
          {g.id === 'paintwork' ? (
            <div
              class="paint-process-proof"
              aria-label="Paint enhancement process and finished work"
            >
              <figure>
                <Photo
                  name="polishing"
                  alt="Machine polisher refining the grey Range Rover paint"
                  sizes="(max-width:760px) 45vw, 16vw"
                />
                <figcaption>Machine polishing in progress</figcaption>
              </figure>
              <figure>
                <Photo
                  name="range-detail"
                  alt="Finished grey Range Rover paint reflecting the sky"
                  sizes="(max-width:760px) 45vw, 16vw"
                />
                <figcaption>Finished Range Rover paintwork</figcaption>
              </figure>
            </div>
          ) : (
            g.image && (
              <div class="service-evidence">
                <Photo name={g.image} alt={g.alt} sizes="(max-width:760px) 75vw, 30vw" />
                {g.detail && (
                  <Photo
                    name={g.detail}
                    alt={g.detailAlt}
                    sizes="(max-width:760px) 35vw, 15vw"
                    class="service-evidence-detail"
                  />
                )}
              </div>
            )
          )}
          {customerReviews
            .filter((review) => review.groupId === g.id)
            .map((review) => (
              <CustomerReview review={review} compact />
            ))}
        </div>
        <div class="service-entries">
          {data.services
            .filter((s) => g.categories.includes(s.category))
            .map((s) => (
              <article
                class:list={[
                  'service-entry',
                  { 'service-entry--featured': serviceRecommendations[s.id] },
                ]}
                id={s.id}
              >
                <div class="service-entry-title">
                  <div class="service-entry-heading">
                    {serviceRecommendations[s.id] && (
                      <span class="service-recommendation">{serviceRecommendations[s.id]}</span>
                    )}
                    <h3>{s.name}</h3>
                  </div>
                  <strong>{s.price.display}</strong>
                </div>
                {s.duration && <p class="duration">{s.duration}</p>}
                <p>{s.summary}</p>
                {s.includes.length > 0 && (
                  <details class="inclusions">
                    <summary>
                      What’s included <Icon name="plus" size={17} />
                    </summary>
                    <ul>
                      {s.includes.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </details>
                )}
                {s.id === 'ceramic-coating' && (
                  <p class="service-policy">
                    {s.deposit?.description}. {s.booking_notes?.join(' ')}
                  </p>
                )}
                {s.id === 'paint-correction' && (
                  <p class="service-policy">
                    We’ll inspect the paint first because some marks are too deep to remove safely.
                  </p>
                )}
                {s.id === 'maintenance-plans' && (
                  <p class="service-policy">
                    Frequency, price and visit duration are agreed with you.
                  </p>
                )}
                <a class="text-link" href={`/booking/?service=${s.id}`}>
                  Enquire about {s.name} <Icon name="diagonal" size={17} />
                </a>
                {s.id === 'ceramic-coating' && (
                  <a class="secondary-service-link" href="/ceramic-coating/">
                    Explore the coating package
                  </a>
                )}
                {customerReviews
                  .filter((review) => review.serviceId === s.id)
                  .map((review) => (
                    <CustomerReview review={review} compact />
                  ))}
              </article>
            ))}
        </div>
      </section>
    ))}
  </div>
  <CTA
    title="Not sure which service fits your car?"
    text="Send a few photos and tell us what you would like to improve. Prices marked “From” may change with vehicle size and condition, but we’ll agree the work and price before you book."
  />
</Layout>
