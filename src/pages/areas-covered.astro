---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import { business } from '../data/business';
import GoogleAreaMap from '../components/GoogleAreaMap.astro';
const pageUrl = new URL('/areas-covered/', Astro.site).href;
const locationSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: 'Areas We Cover | Mobile Detailing from Darlington',
      description: business.coverageSummary,
      about: { '@id': new URL('/#business', Astro.site).href },
      breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
        { '@type': 'ListItem', position: 2, name: 'Areas we cover', item: pageUrl },
      ],
    },
  ],
};
---

<Layout
  title="Areas We Cover | Mobile Detailing from Darlington"
  description={`Mobile valeting, paint correction and ceramic coating within ${business.coverageRadiusMiles} miles of Darlington. Further afield? Get in touch to discuss your location and service.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(locationSchema)} />
  <section class="container coverage-opening">
    <div>
      <nav class="coverage-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true"> / </span>
        <span>Areas we cover</span>
      </nav>
      <p class="eyebrow">Areas we cover</p>
      <h1>
        Based in Darlington.
        <br />
        We come to you.
      </h1>
      <p>{business.coverageSummary}</p>
      <p>
        At home or at work, we bring our own water, power and professional equipment. Send your
        postcode so we can confirm the location before agreeing a visit.
      </p>
      <div class="coverage-actions">
        <a class="button" href="/booking/#postcode">
          Enquire with your postcode <Icon name="pin" />
        </a>
        <a class="text-link" href={business.whatsappHref}>
          Ask on WhatsApp <Icon name="message" />
        </a>
      </div>
    </div>
    <div class="coverage-photos">
      <figure class="coverage-photo">
        <img
          src="/media/middlesbrough-transporter-960.webp"
          srcset="/media/middlesbrough-transporter-480.webp 480w, /media/middlesbrough-transporter-960.webp 960w"
          sizes="(max-width: 760px) calc(100vw - 40px), 40vw"
          width="960" height="720"
          alt="The blue Transporter Bridge and brick dock clock tower in Middlesbrough"
          fetchpriority="high"
        />
        <figcaption>Transporter Bridge, Middlesbrough</figcaption>
      </figure>
      <figure class="coverage-photo coverage-photo-secondary">
        <img
          src="/media/stockton-infinity-bridge-960.webp"
          srcset="/media/stockton-infinity-bridge-480.webp 480w, /media/stockton-infinity-bridge-960.webp 960w"
          sizes="(max-width: 760px) calc(100vw - 40px), 40vw"
          width="960" height="720"
          alt="Infinity Bridge arching over the River Tees in Stockton-on-Tees"
          decoding="async"
        />
        <figcaption>Infinity Bridge, Stockton-on-Tees</figcaption>
      </figure>
      <div class="coverage-photo-note">
        <Icon name="pin" size={20} />
        <span>Within {business.coverageRadiusMiles} miles of Darlington.<br /><a href="/booking/#postcode">Check your postcode with us.</a></span>
      </div>
    </div>
  </section>
  <section class="coverage-local" aria-labelledby="nearby-title">
    <div class="container coverage-grid">
      <div>
        <p class="eyebrow">Local, mobile care</p>
        <h2 id="nearby-title">
          Darlington.
          <br />
          And Teesside.
        </h2>
        <p>
          From Darlington east towards Teesside. Town names are a guide, not a guarantee that
          every address is within the {business.coverageRadiusMiles}-mile area.
        </p>
        <a
          class="text-link"
          href={business.coverageMapUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          View our coverage map <Icon name="diagonal" />
          <span class="sr-only"> (opens in a new tab)</span>
        </a>
        <p>
          <a class="text-link" href={business.googleMaps} target="_blank" rel="noopener noreferrer">
            Polished & Pristine on Google <Icon name="diagonal" />
            <span class="sr-only"> (opens in a new tab)</span>
          </a>
        </p>
      </div>
      <div>
        <ul class="coverage-towns">
          {business.areas.map((area) => (
            <li>
              <Icon name="pin" size={18} />
              {area}
            </li>
          ))}
        </ul>
        <p class="coverage-small">
          We confirm travel availability for your postcode and the service you need. Being within
          the advertised area does not confirm an appointment.
        </p>
      </div>
    </div>
    <div class="container coverage-map-section">
      <GoogleAreaMap />
    </div>
  </section>
  <section class="container coverage-section coverage-grid" aria-labelledby="travel-title">
    <div>
      <h2 id="travel-title">
        Outside the area?
        <br />
        Get in touch.
      </h2>
      <p>
        Send your postcode, vehicle details and the service you have in mind. We’ll discuss whether
        a visit is practical and agree the work and quote before booking.
      </p>
      <p>
        We do not publish a fixed travel charge or promise availability beyond the advertised area.
      </p>
      <a class="text-link" href={business.phoneHref}>
        Call {business.phone} <Icon name="phone" />
      </a>
    </div>
    <div class="coverage-steps">
      <h3>A few details help.</h3>
      <ol>
        <li>
          <strong>Your postcode</strong>
          <span>Where the vehicle will be at the time of the visit.</span>
        </li>
        <li>
          <strong>Your car and the care it needs</strong>
          <span>Make, model and what you would like to improve.</span>
        </li>
        <li>
          <strong>A suitable time and place</strong>
          <span>We’ll discuss availability and conditions before confirming.</span>
        </li>
      </ol>
    </div>
  </section>
  <section class="container coverage-section coverage-grid">
    <h2>
      Coverage
      <br />
      questions
    </h2>
    <FAQ
      items={[
        [
          'Do you cover my address?',
          `Our advertised service area is within ${business.coverageRadiusMiles} miles of Darlington. Send your postcode so we can confirm travel availability for your address and service. If you are further afield, get in touch rather than assuming we cannot help.`,
        ],
        [
          'Can I book automatically if I am inside the area?',
          'No. The current website prepares an enquiry for you to send through WhatsApp or email; it does not automatically check distance or reserve an appointment. We confirm the quote, location and availability directly.',
        ],
        [
          'Do you come to homes and workplaces?',
          'Yes. We are fully mobile and bring our own water and power. We discuss the location and whether it is suitable for the work before confirming the visit.',
        ],
        [
          'Can ceramic coating be done at my location?',
          'Ceramic coating requires suitable dry weather and curing conditions. Send your location and vehicle details so we can discuss a suitable arrangement.',
        ],
      ]}
    />
  </section>
  <section class="container coverage-links" aria-label="Explore services">
    <a href="/valeting/">
      Valeting & interior cleaning <Icon name="arrow" />
    </a>
    <a href="/paint-correction/">
      Paint enhancement & correction <Icon name="arrow" />
    </a>
    <a href="/ceramic-coating/">
      Ceramic coating <Icon name="arrow" />
    </a>
  </section>
  <CTA
    title="Check your postcode with us."
    text="Send your postcode and tell us about your car. We’ll confirm whether we can visit and help you choose the right service."
  />
</Layout>

<style>
  .coverage-breadcrumb {
    font-size: 14px;
    margin-bottom: 24px;
  }
  .coverage-breadcrumb a {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .coverage-map-section {
    margin-top: 48px;
  }
  .coverage-opening {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    align-items: center;
    gap: 7%;
    padding-block: 40px 70px;
  }
  .coverage-opening h1 {
    font-size: clamp(54px, 6.5vw, 92px);
  }
  .coverage-opening p:not(.eyebrow) {
    max-width: 570px;
    color: var(--muted);
    margin-top: 24px;
    font-size: 17px;
  }
  .coverage-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 24px;
    margin-top: 30px;
  }
  .coverage-photos {
    display: grid;
    gap: 12px;
  }
  .coverage-photo {
    position: relative;
    margin: 0;
    background: var(--deep);
    color: white;
    overflow: hidden;
    border-radius: 18px;
    aspect-ratio: 1.6;
  }
  .coverage-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
  }
  .coverage-photo-secondary {
    aspect-ratio: 2.15;
  }
  .coverage-photo figcaption {
    position: absolute;
    inset: auto 0 0;
    padding: 32px 20px 16px;
    background: linear-gradient(transparent, rgb(9 15 19 / 90%));
    font-size: 13px;
    line-height: 1.5;
  }
  .coverage-photo-note {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 8px 4px 0;
    font-size: 14px;
    line-height: 1.65;
    color: var(--muted);
  }
  .coverage-photo-note :global(svg) {
    flex-shrink: 0;
    margin-top: 3px;
    color: var(--accent);
  }
  .coverage-photo-note a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .coverage-local {
    padding-block: 65px;
    background: var(--pale);
  }
  .coverage-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 32px 9%;
  }
  .coverage-grid h2 {
    font-size: clamp(42px, 4.8vw, 66px);
  }
  .coverage-grid p {
    color: var(--muted);
    max-width: 560px;
    font-size: 16px;
  }
  .coverage-towns {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0 24px;
  }
  .coverage-towns li {
    display: flex;
    align-items: center;
    gap: 10px;
    border-bottom: 1px solid var(--line);
    padding-block: 14px;
    font-size: 16px;
  }
  .coverage-towns :global(svg) {
    flex-shrink: 0;
  }
  .coverage-small {
    font-size: 14px !important;
  }
  .coverage-section {
    padding-block: 70px;
  }
  .coverage-steps {
    border-top: 2px solid var(--accent);
    padding-top: 25px;
  }
  .coverage-steps h3 {
    font-size: 30px;
  }
  .coverage-steps ol {
    padding-left: 22px;
    margin: 24px 0 0;
  }
  .coverage-steps li {
    padding: 0 0 22px 10px;
  }
  .coverage-steps strong,
  .coverage-steps span {
    display: block;
    font-size: 16px;
  }
  .coverage-steps span {
    color: var(--muted);
    margin-top: 4px;
  }
  .coverage-grid :global(.faq-list summary),
  .coverage-grid :global(.faq-answer p) {
    font-size: 16px;
  }
  .coverage-links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    border-top: 1px solid var(--line);
    padding-block: 28px 60px;
  }
  .coverage-links a {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    font-size: 15px;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  @media (max-width: 760px) {
    .coverage-opening,
    .coverage-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .coverage-opening {
      padding-block: 28px 48px;
      gap: 32px;
    }
    .coverage-opening h1 {
      font-size: clamp(48px, 11vw, 76px);
    }
    .coverage-opening p:not(.eyebrow) {
      font-size: 16px;
    }
    .coverage-local,
    .coverage-section {
      padding-block: 48px;
    }
    .coverage-towns {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
