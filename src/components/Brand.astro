---
const { footer = false } = Astro.props;
---

<a
  href="/"
  class:list={['brand', { 'footer-brand': footer }]}
  aria-label="Polished & Pristine home"
  translate="no"
>
  <svg
    class="brand-emblem"
    width="48"
    height="46"
    viewBox="0 0 64 64"
    fill="none"
    aria-hidden="true"
  >
    <path
      d="M43 16c5-3 11-5 16-5 4 0 5 3 4 7l-1 5c-1 3-4 3-7 3l-10 3 1-7 10-3c2-.6 2-2 1-2-4 0-8 2-11 3l-3-4Z"
      fill="currentColor"
    />
    <path
      d="M9 29c1-4 6-6 11-8l9-3c5-2 9 1 13-1 4 3 5 7 3 11-2 5-9 7-15 8l-3 4-6-3c4-6 1-8-4-5l-4 2c-5 2-7-1-4-5Zm5-2c-1 1 0 2 2 2l14-5c4-2 3-4-1-3l-15 6Zm20 1-3 6 3-1 3-6-3 1Zm6-2-3 6 3-1 3-6-3 1Z"
      fill="currentColor"
      fill-rule="evenodd"
    />
    <path
      d="M13 35c3-2 6-3 9-1l4 7c-4 3-12 3-17 0l4-6ZM7 42c5 5 17 5 22 0 3 0 4 3 2 4-6 4-19 4-25 0-2-2-1-3 1-4ZM6 48c6 4 20 4 26-1l4 5c6 8-38 9-33 0l3-4Z"
      fill="currentColor"
    />
  </svg>
  <span class="brand-wordmark">
    Polished <span>& Pristine</span>
    <small>Mobile detailing</small>
  </span>
</a>
