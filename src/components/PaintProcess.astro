---
import Photo from './Photo.astro';

const stages = [
  {
    image: 'range-assessment',
    title: '01 · Check the paint',
    alt: 'Fine marks and water droplets visible on a grey Range Rover door during assessment',
    copy: 'Look at the condition and discuss the marks you want to improve. Not every scratch can be safely removed.',
  },
  {
    image: 'polishing',
    title: '02 · Refine the surface',
    alt: 'Machine polisher working on the grey Range Rover side panel',
    copy: 'After cleaning and preparation, machine polishing improves suitable marks and the clarity of the finish.',
  },
  {
    image: 'range-detail',
    title: '03 · See the result',
    alt: 'Finished Range Rover bonnet reflecting the sky',
    copy: 'A closer look at the finished paint. This is the same Range Rover job, shown from a different angle and in different light.',
  },
];
---

<section
  class="category-proof category-section paint-process"
  aria-labelledby="paint-process-title"
>
  <div class="container category-paint-process" data-paint-process>
    <div class="category-section-heading">
      <h2 id="paint-process-title">
        How we polish
        <br />
        the paint.
      </h2>
      <p>
        A look at assessment, polishing and the finished paint from a real Range Rover detail. Not a
        simulated before-and-after effect.
      </p>
    </div>
    <div class="category-process-line" aria-hidden="true">
      <span></span>
    </div>
    <div class="category-process-grid">
      {stages.map((stage) => (
        <figure>
          <Photo name={stage.image} alt={stage.alt} sizes="(max-width:760px) 90vw, 29vw" />
          <figcaption>
            <h3>{stage.title}</h3>
            <p>{stage.copy}</p>
          </figcaption>
        </figure>
      ))}
    </div>
    <p class="category-proof-note">
      Different panels, viewpoints and lighting. These photographs demonstrate the process, not a
      measured percentage of defect removal.
    </p>
  </div>
</section>

<style>
  .paint-process {
    padding-block: clamp(48px, 6vw, 80px);
    background: var(--deep);
    color: var(--paper);
  }
  .category-paint-process {
    position: relative;
  }
  .category-section-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
    gap: 24px 8%;
    align-items: end;
    margin-bottom: 36px;
  }
  .category-section-heading h2 {
    font-size: clamp(42px, 4.8vw, 66px);
  }
  .category-section-heading > p {
    max-width: 530px;
    margin: 0;
    color: #bfcbd1;
  }
  .category-process-line {
    height: 3px;
    margin: 0 0 30px;
    overflow: hidden;
    background: #344148;
  }
  .category-process-line span {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--accent);
    transform-origin: left center;
  }
  .category-process-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }
  .category-process-grid figure {
    min-width: 0;
    margin: 0;
  }
  .category-process-grid :global(picture) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 4px;
    background: #263239;
  }
  .category-process-grid :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .category-process-grid figure:nth-child(2) :global(img) {
    object-position: 30% 65%;
  }
  .category-process-grid figcaption {
    padding-top: 24px;
  }
  .category-process-grid h3 {
    font-size: clamp(24px, 2.25vw, 32px);
    line-height: 1.2;
  }
  .category-process-grid p {
    margin-top: 12px;
    color: #bfcbd1;
    font-size: 16px;
  }
  .category-proof-note {
    max-width: none;
    margin: 24px 0 0;
    padding-top: 20px;
    border-top: 1px solid #344148;
    color: #bfcbd1;
    font-size: 14px;
  }
  @media (max-width: 760px) {
    .category-section-heading,
    .category-process-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .category-process-line {
      display: none;
    }
    .category-process-grid {
      gap: 32px;
    }
    .category-process-grid figure {
      display: grid;
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
      gap: 18px;
      align-items: center;
    }
    .category-process-grid :global(picture) {
      height: 100%;
      min-height: 210px;
      aspect-ratio: 3 / 4;
    }
    .category-process-grid figcaption {
      padding: 0;
    }
    .category-process-grid h3 {
      font-size: 24px;
    }
    .category-process-grid p {
      margin-bottom: 0;
      font-size: 14px;
    }
  }
  @media (max-width: 370px) {
    .category-process-grid figure {
      grid-template-columns: minmax(0, 1fr);
    }
    .category-process-grid :global(picture) {
      height: 300px;
    }
  }
</style>
