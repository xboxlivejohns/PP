---
import manifest from '../data/media.json';
import artSelection from '../../content/art-media-selection.json';
import editorialSelection from '../../content/editorial-media-selection.json';
const {
  name,
  alt,
  eager = false,
  sizes = '(max-width: 700px) 100vw, 50vw',
  class: className = '',
} = Astro.props;
const media =
  manifest[name as keyof typeof manifest] ||
  artSelection.assets.find((item) => item.name === name) ||
  editorialSelection.assets.find((item) => item.name === name)!;
const srcset = (type: string) =>
  media.widths.map((w) => `/media/${name}-${w}.${type} ${w}w`).join(', ');
---

<picture class={className}>
  <source type="image/avif" srcset={srcset('avif')} sizes={sizes} />
  <img
    src={`/media/${name}-${media.widths.includes(800) ? 800 : media.widths[0]}.webp`}
    srcset={srcset('webp')}
    sizes={sizes}
    width={media.width}
    height={media.height}
    alt={alt}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding="async"
  />
</picture>
