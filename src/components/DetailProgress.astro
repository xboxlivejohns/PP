---
import scene from '../assets/detailing-scene.svg?raw';
---

<!-- Decorative scroll feedback. Navigation and page content never depend on it. -->
<div class="header-detail" data-detail-progress aria-hidden="true">
  <div class="header-detail-actor" data-detail-actor set:html={scene} />
  <span class="header-detail-rail">
    <span data-detail-fill></span>
  </span>
</div>
