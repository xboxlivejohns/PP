---
import type { customerReviews } from '../data/reviews';
interface Props {
  review: (typeof customerReviews)[number];
  compact?: boolean;
  panel?: boolean;
}
const { review, compact = false, panel = false } = Astro.props;
const [firstName, ...surnames] = review.name.trim().split(/\s+/);
const displayName = [firstName, ...surnames.map((name) => `${name[0].toUpperCase()}.`)].join(' ');
---

<figure
  class:list={['customer-review', { 'customer-review--compact': compact, 'customer-review--panel': panel }]}
  data-review-id={review.id}
>
  <p class="customer-review-topic">
    {review.topic}
    {panel && <span class="customer-review-mark" aria-hidden="true">“</span>}
  </p>
  <blockquote>
    <p><q>{review.quote}</q></p>
  </blockquote>
  <figcaption>
    <strong>{displayName}</strong>
    {review.date && <time datetime={review.date}>{review.dateLabel}</time>}
    <a href={review.href} target="_blank" rel="noopener noreferrer">
      {review.sourceLabel || `Review on ${review.source}`}
      <span class="sr-only"> (opens in a new tab)</span>
    </a>
  </figcaption>
</figure>

<style>
  .customer-review {
    margin: 0;
    min-width: 0;
    padding: 28px 0;
    border-top: 2px solid var(--accent, #315ee7);
    overflow-wrap: anywhere;
  }
  .customer-review .customer-review-topic {
    margin: 0 0 20px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 700;
  }
  .customer-review blockquote {
    margin: 0;
    padding: 0;
    border: 0;
  }
  .customer-review blockquote p {
    margin: 0;
    color: var(--ink);
    font-size: 18px;
    line-height: 1.8;
    font-style: italic;
    white-space: pre-line;
  }
  .customer-review figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 14px;
    margin-top: 22px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.7;
  }
  .customer-review figcaption strong {
    color: var(--ink);
  }
  .customer-review figcaption a {
    flex-basis: 100%;
    width: fit-content;
    padding-block: 6px;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .customer-review--compact {
    margin-top: 28px;
    padding: 22px 0 0;
    grid-column: 1 / -1;
  }
  .customer-review--compact blockquote p {
    font-size: 16px;
  }
  .customer-review--compact .customer-review-topic {
    margin-bottom: 12px;
  }
  .customer-review--panel {
    display: flex;
    flex-direction: column;
    padding: clamp(24px, 3vw, 36px);
    border: 1px solid var(--line);
    border-radius: 14px;
    background: #fff;
  }
  .customer-review--panel .customer-review-topic {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 18px;
    font-size: 13px;
  }
  .customer-review-mark {
    flex-shrink: 0;
    height: 32px;
    color: var(--accent, #315ee7);
    font: 60px/1 Georgia, serif;
  }
  .customer-review--panel blockquote {
    flex: 1;
  }
  .customer-review--panel blockquote p {
    font-size: 17px;
    line-height: 1.8;
  }
  .customer-review--panel figcaption {
    border-top: 1px solid var(--line);
    padding-top: 18px;
    margin-top: 26px;
  }
  .customer-review--panel figcaption a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
</style>
