---
import Icon from './Icon.astro';
const current = Astro.url.pathname;
const destinations = [
  {
    href: '/valeting/',
    label: 'Valeting & interior cleaning',
    description: 'Regular refreshes and deeper cleans.',
    icon: 'check',
  },
  {
    href: '/paint-correction/',
    label: 'Paint enhancement & correction',
    description: 'Improve gloss, swirls and suitable marks.',
    icon: 'sparkle',
  },
  {
    href: '/ceramic-coating/',
    label: 'Ceramic coating',
    description: 'Careful preparation. Longer-term protection.',
    icon: 'shield',
  },
];
const active = current === '/services/' || destinations.some(({ href }) => href === current);
---

<details class="service-navigation" data-service-navigation>
  <summary class:list={{ 'service-navigation-active': active }}>
    Services
    <svg
      class="service-navigation-chevron"
      width="14"
      height="14"
      viewBox="0 0 16 16"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="m4 6 4 4 4-4"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </summary>
  <div class="service-navigation-links">
    <a
      class="service-navigation-overview"
      href="/services/"
      aria-current={current === '/services/' ? 'page' : undefined}
    >
      <span>
        <strong>All services & prices</strong>
        <small>Find the right care for your car.</small>
      </span>
      <Icon name="diagonal" size={20} />
    </a>
    <div class="service-navigation-categories">
      {destinations.map(({ href, label, description, icon }) => (
        <a
          class="service-navigation-category"
          href={href}
          aria-current={current === href ? 'page' : undefined}
        >
          <span class="service-navigation-icon">
            <Icon name={icon} size={21} />
          </span>
          <span class="service-navigation-copy">
            <strong>{label}</strong>
            <small>{description}</small>
          </span>
          <span class="service-navigation-arrow">
            <Icon name="arrow" size={17} />
          </span>
        </a>
      ))}
    </div>
    <a class="service-navigation-advice" href="/booking/?service=not-sure">
      Not sure? Ask your detailer <Icon name="message" size={17} />
    </a>
  </div>
</details>
