{
  "name": "polished-pristine-website",
  "private": true,
  "type": "module",
  "scripts": {
    "inventory": "node tools/build-review.mjs",
    "previews": "node tools/build-selected-previews.mjs",
    "review": "node tools/serve-review.mjs",
    "optimise": "node tools/optimise-images.mjs",
    "optimise:video": "node tools/optimise-video.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "check:site": "node tools/check-built-site.mjs",
    "deploy": "node tools/publish-pages.mjs",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "media:build": "node tools/build-site-media.mjs",
    "test": "playwright test",
    "format": "prettier --write src tests astro.config.mjs playwright.config.js"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "astro": "^7.4.11",
    "gsap": "^3.15.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2"
  }
}
